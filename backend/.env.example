# Copy to .env and edit. The backend reads these from the environment.

# SQLite needs no install and is fine for a team of 10-15.
DATABASE_URL=sqlite:///./dispatch.db
# Postgres, when you outgrow it:
# DATABASE_URL=postgresql+psycopg2://dispatch:dispatch@localhost:5432/dispatch

# Sign tokens with a long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-before-you-deploy-this
JWT_HOURS=12

# Where the browser app is served from.
CORS_ORIGINS=http://localhost:5173
